
from coppeliasim_zmqremoteapi_client import RemoteAPIClient
import math

# --------------------------------------------------
# 1. Connect to CoppeliaSim
# --------------------------------------------------
client = RemoteAPIClient()
sim = client.require("sim")

print("Connected to CoppeliaSim")

# Run this generator with simulation STOPPED.
# It creates the robot in the currently open scene.

# --------------------------------------------------
# 2. Helper functions
# --------------------------------------------------
def create_box(name, size, position, orientation=None):
    """Create a cuboid using world coordinates."""
    obj = sim.createPrimitiveShape(
        sim.primitiveshape_cuboid,
        list(size),
        0
    )
    sim.setObjectAlias(obj, name)
    sim.setObjectPosition(obj, list(position), -1)

    if orientation is not None:
        sim.setObjectOrientation(obj, list(orientation), -1)

    return obj


def create_revolute_joint(name, position, orientation):
    """Create a kinematic revolute joint."""
    joint = sim.createJoint(
        sim.joint_revolute_subtype,
        sim.jointmode_kinematic,
        0,
        [0.04, 0.02]
    )
    sim.setObjectAlias(joint, name)
    sim.setObjectPosition(joint, list(position), -1)
    sim.setObjectOrientation(joint, list(orientation), -1)
    return joint


# --------------------------------------------------
# 3. Ground and body
# --------------------------------------------------
ground = create_box(
    "Ground",
    (2.0, 2.0, 0.02),
    (0.0, 0.0, -0.01)
)

body = create_box(
    "HexapodBody",
    (0.30, 0.22, 0.06),
    (0.0, 0.0, 0.34)
)

print("Created ground and body")

# --------------------------------------------------
# 4. Six legs and twelve revolute joints
# --------------------------------------------------
legs = []

for i in range(6):
    # Six evenly spaced legs around the body
    angle = i * math.pi / 3
    dx = math.cos(angle)
    dy = math.sin(angle)

    # Hip joint center
    hip_pos = (
        0.12 * dx,
        0.12 * dy,
        0.31
    )

    # Knee joint center
    knee_pos = (
        0.28 * dx,
        0.28 * dy,
        0.31
    )

    # Hip: rotates around the vertical axis
    hip = create_revolute_joint(
        f"HipJoint_{i + 1}",
        hip_pos,
        (0.0, 0.0, angle)
    )

    # Upper leg: extends outward from the body
    upper = create_box(
        f"UpperLeg_{i + 1}",
        (0.16, 0.035, 0.035),
        (0.20 * dx, 0.20 * dy, 0.31),
        (0.0, 0.0, angle)
    )

    # Knee: oriented to bend in the radial/vertical plane
    knee = create_revolute_joint(
        f"KneeJoint_{i + 1}",
        knee_pos,
        (math.pi / 2, 0.0, angle)
    )

    # Lower leg: initially extends down toward the ground
    lower = create_box(
        f"LowerLeg_{i + 1}",
        (0.035, 0.035, 0.20),
        (knee_pos[0], knee_pos[1], 0.20)
    )

    # Build the parent-child hierarchy.
    # True preserves the existing world positions.
    sim.setObjectParent(hip, body, True)
    sim.setObjectParent(upper, hip, True)
    sim.setObjectParent(knee, upper, True)
    sim.setObjectParent(lower, knee, True)

    legs.append({
        "hip": hip,
        "knee": knee,
        "upper": upper,
        "lower": lower,
    })

    print(f"Created leg {i + 1}: hip + knee")

print("\nRobot generation complete.")
print("Legs:", len(legs))
print("Revolute joints:", sum(
    1 for leg in legs for key in ("hip", "knee")
))
print("Inspect the scene before starting the simulation.")
